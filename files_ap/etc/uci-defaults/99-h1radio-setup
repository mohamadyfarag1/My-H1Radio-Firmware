#!/bin/sh

# =============================================
# Horus 9200 - First Boot Configuration
# =============================================

# 1. System & UI
uci set system.@system[0].hostname='Horus-9200'
uci commit system
uci set luci.main.mediaurlbase='/luci-static/openwrt2020'
uci commit luci

# 2. Bridge Device (br-lan) with all LAN ports
uci set network.@device[0].name='br-lan'
uci set network.@device[0].type='bridge'
uci delete network.@device[0].ports 2>/dev/null
uci add_list network.@device[0].ports='lan1'
uci add_list network.@device[0].ports='lan2'
uci add_list network.@device[0].ports='lan3'
uci add_list network.@device[0].ports='lan4'
uci set network.@device[0].stp='1'
uci set network.@device[0].ipv6='0'

# 3. LAN interface (Static, no DHCP server)
uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.100.1'
uci set network.lan.netmask='255.255.255.0'
uci set network.lan.ipv6='0'

# Disable DHCP server (this is an AP, not a router)
uci set dhcp.lan.ignore='1'

# Disable IPv6 DHCP/RA
uci -q set dhcp.lan.dhcpv6='disabled'
uci -q set dhcp.lan.ra='disabled'
uci -q set dhcp.lan.ndp='disabled'
/etc/init.d/odhcpd disable 2>/dev/null || true

# 4. WAN interface (for when used as router)
uci set network.wan=interface
uci set network.wan.device='wan'
uci set network.wan.proto='dhcp'

uci set network.wan6=interface
uci set network.wan6.device='wan'
uci set network.wan6.proto='dhcpv6'

# Enable Packet Steering for multi-core performance
uci set network.@globals[0].packet_steering='1'

uci commit network

# 5. Radio 0 (2.4GHz) - Superchannel ready
uci set wireless.radio0.disabled='0'
uci set wireless.radio0.country='US'
uci set wireless.radio0.channel='1'
uci set wireless.radio0.htmode='HT20'
uci set wireless.radio0.txpower='30'
uci set wireless.radio0.noscan='1'
uci set wireless.radio0.distance='5000'

# 6. Radio 1 (5GHz) - AC forced, Superchannel ready
uci set wireless.radio1.disabled='0'
uci set wireless.radio1.country='US'
uci set wireless.radio1.channel='149'
uci set wireless.radio1.htmode='VHT80'
uci set wireless.radio1.txpower='30'
uci set wireless.radio1.noscan='1'
uci set wireless.radio1.distance='5000'
uci -q set wireless.radio1.require_mode='ac'

# 7. WiFi AP interfaces (WDS + high bitrates)
uci set wireless.default_radio0.disabled='0'
uci set wireless.default_radio0.ssid='Horus-2.4'
uci set wireless.default_radio0.encryption='none'
uci set wireless.default_radio0.network='lan'
uci set wireless.default_radio0.mode='ap'
uci set wireless.default_radio0.wds='1'
uci set wireless.default_radio0.mcast_rate='24000'
uci delete wireless.default_radio0.basic_rate 2>/dev/null
uci add_list wireless.default_radio0.basic_rate='24000'
uci add_list wireless.default_radio0.basic_rate='54000'

uci set wireless.default_radio1.disabled='0'
uci set wireless.default_radio1.ssid='Horus-5G'
uci set wireless.default_radio1.encryption='none'
uci set wireless.default_radio1.network='lan'
uci set wireless.default_radio1.mode='ap'
uci set wireless.default_radio1.wds='1'
uci set wireless.default_radio1.disassoc_low_ack='0'
uci set wireless.default_radio1.mcast_rate='24000'
uci delete wireless.default_radio1.basic_rate 2>/dev/null
uci add_list wireless.default_radio1.basic_rate='24000'
uci add_list wireless.default_radio1.basic_rate='54000'

uci commit wireless
wifi

# 8. Firewall Software Offloading
uci set firewall.@defaults[0].flow_offloading='1'
uci set firewall.@defaults[0].flow_offloading_hw='0'
uci commit firewall

# 9. SMP IRQ Affinity (distribute interrupts across CPU cores)
cat << 'EOF' > /etc/init.d/smp_affinity
#!/bin/sh /etc/rc.common
START=99

start() {
    ETH_IRQS=$(grep -E 'eth|edma' /proc/interrupts | awk -F: '{print $1}' | tr -d ' ')
    for irq in $ETH_IRQS; do
        [ -f "/proc/irq/$irq/smp_affinity" ] && echo 1 > "/proc/irq/$irq/smp_affinity"
    done

    WIFI_IRQS=$(grep -E 'ath10k|wifi' /proc/interrupts | awk -F: '{print $1}' | tr -d ' ')
    IDX=0
    for irq in $WIFI_IRQS; do
        if [ "$IDX" -eq 0 ]; then
            [ -f "/proc/irq/$irq/smp_affinity" ] && echo 4 > "/proc/irq/$irq/smp_affinity"
        else
            [ -f "/proc/irq/$irq/smp_affinity" ] && echo 8 > "/proc/irq/$irq/smp_affinity"
        fi
        IDX=$((IDX + 1))
    done
}
EOF

chmod +x /etc/init.d/smp_affinity
/etc/init.d/smp_affinity enable

# 10. rc.local: 5GHz Bitrates Lock + CPU Performance
cat << 'RCEOF' > /etc/rc.local
#!/bin/sh
# Force 5GHz to high bitrates to prevent slow connections
for iface in $(iw dev | grep -B 1 "phy#1" -A 2 | grep Interface | awk '{print $2}'); do
    iw dev "$iface" set bitrates vht-mcs-5 1:2-9 2:1-9 3:1-9 4:0-9
done

# CPU Performance Mode
for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    echo "performance" > $cpu 2>/dev/null
done

exit 0
RCEOF
chmod +x /etc/rc.local

# 11. Enable services
/etc/init.d/irqbalance enable 2>/dev/null
/etc/init.d/network restart

exit 0
